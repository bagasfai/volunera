# supabase/functions/.env.example
# Platform-owned Google account's OAuth credentials for Calendar API access.
# Set locally with: supabase functions serve booking-calendar-event --env-file supabase/functions/.env
# Set for the hosted project with: supabase secrets set --env-file supabase/functions/.env
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Not set via this file, but a reminder for whoever calls this function
# directly (curl, the Postgres trigger's Vault secret, etc.): authenticate
# with the `apikey` header set to the `SECRET_KEY` field from
# `npx supabase status` (starts with `sb_secret_`) — NOT `SERVICE_ROLE_KEY`
# (the legacy JWT). `withSupabase({ auth: "secret" })` validates against
# `apikey` specifically; a JWT sent as `Authorization: Bearer` will not work.

# Resend API credentials for booking-notification-email.
# Set locally with: supabase functions serve booking-notification-email --env-file supabase/functions/.env
# Set for the hosted project with: supabase secrets set --env-file supabase/functions/.env
RESEND_API_KEY=
# Must be a verified sender/domain in your Resend account, e.g. "Learnivia <bookings@yourdomain.org>"
EMAIL_FROM_ADDRESS=
