# Copy to .env.local and fill in from `npx supabase status`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. The `SECRET_KEY` field from `npx supabase status` (local, starts
# with `sb_secret_`) or Dashboard > Settings > API Keys (hosted) — NOT
# `SERVICE_ROLE_KEY` (the legacy JWT).
# Used to call the booking Edge Functions (booking-calendar-event, booking-notification-email) from server actions. Never expose to the browser.
SUPABASE_SECRET_KEY=

SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
